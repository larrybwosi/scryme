# =========================================================================
#                       SCRYME ENVIRONMENT CONFIGURATION
# =========================================================================

# --- DOMAIN CONFIGURATION (For production/reverse proxy routing) ---
# Used by Traefik and routing services to construct host matching rules
WEB_DOMAIN=scryme.tech
CRM_DOMAIN=crm.scryme.tech
API_DOMAIN=api.scryme.tech
WINDMILL_DOMAIN=windmill.scryme.tech
RUSTFS_DOMAIN=storage.scryme.tech
RUSTFS_CONSOLE_DOMAIN=storage-console.scryme.tech
MAILPIT_HOST=mail.scryme.tech
PORTAL_DOMAIN=portal.scryme.tech
BAKERY_DOMAIN=bakery.scryme.tech
DOCS_DOMAIN=docs.scryme.tech

# --- DOCKER PROXY / PLATFORM CONFIGURATION ---
# Docker network name for the platform proxy (e.g., Dokploy, Coolify, or Traefik)
PROXY_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- DATABASE CONFIGURATION ---
# Core application PostgreSQL database credentials
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=dbpassword
POSTGRES_DB=app_db
DATABASE_URL=postgresql://dbuser:dbpassword@db:5432/app_db?schema=public

# Customer Auth PostgreSQL database credentials
CUSTOMER_DB_USER=customer_user
CUSTOMER_DB_PASSWORD=customer_pass
CUSTOMER_DB_NAME=customer_db
CUSTOMER_DB=postgresql://customer_user:customer_pass@customer-db:5432/customer_db?schema=public

# --- REDIS CONFIGURATION ---
# Caching service configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- RABBITMQ CONFIGURATION ---
# Message queue credentials and connection URL
RABBITMQ_USER=scryme
RABBITMQ_PASS=rabbitmqsecret
RABBITMQ_URL=amqp://scryme:rabbitmqsecret@rabbitmq:5672

# --- REVERSE PROXY SUPPORT & COMPATIBILITY ---
# Instructs Better-Auth to trust proxy headers forwarded by Traefik/Caddy/Nginx
BETTER_AUTH_TRUST_HOST=true
# Point BETTER_AUTH_URL to the external user-facing site
BETTER_AUTH_URL=http://localhost:3000
# Instructs the NestJS API server to trust proxy headers
TRUST_PROXY=true

# --- SERVICE PORT CONFIGURATION ---
# Internal application ports. Must match service exposures
API_PORT=4000
WEB_PORT=3000
CRM_PORT=3001
BAKERY_PORT=3003
PORTAL_PORT=3006
DOCS_PORT=3008

# --- API & PUBLIC CLIENT CONFIGURATION ---
# Publicly accessible URLs for clients to connect to services.
# When deploying using Docker Compose, change localhost to the appropriate DOMAIN or host.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_CRM_URL=http://localhost:3001
NEXT_PUBLIC_PORTAL_URL=http://localhost:3006

# --- SECURITY SECRETS ---
# Cryptographic keys and secrets used across applications.
# Make sure to generate strong random values for production.
JWT_SECRET=jwtsecret1234567890jwtsecret
BETTER_AUTH_SECRET=betterauthsecret1234567890secret
INTERNAL_ADMIN_SECRET=adminsecret1234567890secret
ENCRYPTION_KEY=encryptionkey1234567890key12345

# --- STORAGE CONFIGURATION ---
STORAGE_PROVIDER=rustfs # Options: rustfs, sanity (optional)

# RustFS (S3 Compatible Storage Server) Configuration
# Default self-hosted storage settings mapping to rustfs container
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=your-access-key
RUSTFS_SECRET_KEY=your-secret-key
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=dealio-uploads
RUSTFS_FORCE_PATH_STYLE=true
RUSTFS_PUBLIC_URL=http://localhost:9000

# Optional: Sanity CMS Configuration (Only needed if utilizing Sanity storefront/site schema)
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=your-dataset
SANITY_API_TOKEN=your-api-token
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=your-dataset

# --- REALTIME CONFIGURATION ---
# Realtime subscription broker. Options: socketio, ably (optional)
REALTIME_PROVIDER=socketio
NEXT_PUBLIC_REALTIME_PROVIDER=socketio

# Socket.io Settings (Default)
SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Optional: Ably Realtime Settings (Only needed if REALTIME_PROVIDER=ably)
ABLY_API_KEY=your-ably-api-key

# --- SCRYME CHAT/SYSTEM CONFIGURATION (Optional) ---
SCRYME_CHAT_API_URL=https://api.chat.scryme.tech
SCRYME_CHAT_CLIENT_ID=your-scryme-chat-client-id
SCRYME_CHAT_CLIENT_SECRET=your-scryme-chat-client-secret
SCRYME_SYSTEM_WORKSPACE_SLUG=your-scryme-system-workspace-slug
SCRYME_SYSTEM_CHANNEL_SLUG=your-scryme-system-channel-slug
SCRYME_WEBHOOK_SECRET=your-scryme-webhook-secret
SCRYME_ACTION_WORKFLOW_PATH=your-scryme-action-workflow-path

# --- OPENPANEL ANALYTICS CONFIGURATION (Optional) ---
OPENPANEL_CLIENT_ID=your-openpanel-client-id
OPENPANEL_CLIENT_SECRET=your-openpanel-client-secret
OPENPANEL_HOST=https://api.openpanel.dev
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=your-openpanel-client-id
NEXT_PUBLIC_OPENPANEL_HOST=https://api.openpanel.dev
VITE_OPENPANEL_CLIENT_ID=your-openpanel-client-id
VITE_OPENPANEL_HOST=https://api.openpanel.dev
