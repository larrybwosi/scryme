model User {
  id                   String        @id @default(cuid())
  name                 String?
  email                String        @unique
  password             String?
  role                 UserRole      @default(MEMBER)
  isActive             Boolean       @default(true)
  deletedAt            DateTime?
  version              Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  emailVerified        Boolean?
  image                String?
  banned               Boolean?
  banReason            String?
  banExpires           DateTime?
  username             String?
  acquisitionSource    String?
  accounts             Account[]
  members              Member[]
  invitations          Invitation[]
  sessions             Session[]
  passkeys             Passkey[]
  ssoProviders         SsoProvider[]
  twoFactorEnabled     Boolean?      @default(false)
  twoFactor            TwoFactor[]
  activeOrganizationId String?
  displayUsername      String?
  scrymeUserId         String?
  customerId           String?
  organizationId       String?
  apikeys              Apikey[]
  banner               String? // To store the URL of the profile banner image
  notificationPrefs    Json? // To store notification settings like { "mentions": true, "taskUpdates": false }

  // Referral System Fields
  referralCode  String?    @unique
  referrerId    String?
  referrer      User?      @relation("UserReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  referees      User[]     @relation("UserReferrer")
  referralsMade Referral[] @relation("ReferredBy")
  referredBy    Referral?  @relation("ReferredUser")

  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]

  @@unique([username])
  @@map("user")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String?
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  activeOrganizationId String?

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@map("session")
}

model Apikey {
  id                  String    @id
  name                String?
  start               String?
  prefix              String?
  key                 String
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?
  rateLimitEnabled    Boolean?
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@map("apikey")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DEVELOPER
  CLIENT
  MEMBER
}

enum RateLimitTier {
  LOW // 100 req/min
  STANDARD // 500 req/min
  HIGH // 2000 req/min
  UNLIMITED
}

// API key usage logs for rate limiting and analytics
model ApiKeyUsageLog {
  id       String @id @default(cuid())
  apiKeyId String
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  endpoint   String // API endpoint called
  method     String // HTTP method
  statusCode Int // Response status code
  ipAddress  String? // Client IP
  userAgent  String? // Client user agent

  requestSize  Int? // Request size in bytes
  responseSize Int? // Response size in bytes
  duration     Int? // Request duration in ms

  timestamp DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([timestamp])
  @@index([endpoint])
  @@index([organizationId])
  @@map("api_key_usage_log")
}

model OauthClient {
  id                               String    @id @default(cuid())
  clientId                         String    @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?  @default(false)
  public                           Boolean?  @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]  @default([])
  userId                           String?
  user                             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt                        DateTime? @default(now())
  updatedAt                        DateTime? @updatedAt
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]  @default([])
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]  @default([])
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]  @default(["authorization_code", "refresh_token"])
  responseTypes                    String[]  @default(["code"])
  requirePKCE                      Boolean?  @default(true)
  dpopBoundAccessTokens            Boolean?  @default(false)
  referenceId                      String?
  metadata                         Json?

  refreshTokens   OauthRefreshToken[]
  accessTokens    OauthAccessToken[]
  consents        OauthConsent[]
  clientResources OauthClientResource[]

  @@map("oauth_client")
}

model OauthResource {
  id                            String    @id @default(cuid())
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?  @default(false)
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime? @default(now())
  updatedAt                     DateTime? @updatedAt
  policyVersion                 Int?      @default(1)
  metadata                      Json?

  clientResources OauthClientResource[]

  @@map("oauth_resource")
}

model OauthClientResource {
  id         String        @id @default(cuid())
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?     @default(now())

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

model OauthRefreshToken {
  id                      String      @id @default(cuid())
  token                   String      @unique
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime?
  createdAt               DateTime?   @default(now())
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]

  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id                      String             @id @default(cuid())
  token                   String?            @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  refreshToken            OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: SetNull)
  expiresAt               DateTime?
  createdAt               DateTime?          @default(now())
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id                      String      @id @default(cuid())
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime?   @default(now())
  updatedAt               DateTime?   @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

model OauthClientAssertion {
  id        String   @id @default(cuid())
  expiresAt DateTime

  @@map("oauth_client_assertion")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@map("two_factor")
}

model SsoProvider {
  id             String  @id @default(cuid())
  issuer         String
  oidcConfig     String?
  samlConfig     String?
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId     String  @unique
  organizationId String?
  domain         String

  @@map("ssoProvider")
}
