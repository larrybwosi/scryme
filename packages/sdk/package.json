{
  "name": "@scryme/sdk",
  "version": "10.2.45",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "dist/client.d.ts"
      ],
      "server": [
        "dist/server.d.ts"
      ],
      "react": [
        "dist/react.d.ts"
      ]
    }
  },
  "scripts": {
    "generate": "echo 'SDK already generated'",
    "generate:ts": "orval",
    "generate:rust": "openapi-generator-cli generate --skip-validate-spec -i ./openapi.json -g rust -o ./rust --additional-properties=packageName=scryme-sdk,packageVersion=10.2.45 --global-property apiDocs=false,modelDocs=false",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.18.0",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "orval": "^8.23.0",
    "react": "^19.2.14",
    "tsup": "^8.5.1",
    "typescript": "5.7.3",
    "vitest": "^3.0.7"
  }
}
