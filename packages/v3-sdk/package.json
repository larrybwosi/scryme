{
  "name": "@scryme/sdk",
  "version": "9.64.1",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "dist/client.d.ts"
      ],
      "server": [
        "dist/server.d.ts"
      ]
    }
  },
  "scripts": {
    "generate": "orval",
    "build": "tsup src/index.ts src/client.ts src/server.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/client.ts src/server.ts --format cjs,esm --dts --watch",
    "test": "jest",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "orval": "^8.23.0",
    "ts-jest": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "5.7.3"
  }
}
