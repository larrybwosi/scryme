# Payload CMS Configuration
PAYLOAD_SECRET=your-payload-secret-key-32-chars
DATABASE_URL=postgresql://dbuser:dbpassword@localhost:5432/app_db?schema=public
PAYLOAD_DB_PUSH=true

# SMTP Mailer Configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_ADDRESS=noreply@scryme.tech
SMTP_FROM_NAME=Scryme CMS

# Server & Client Domain
NEXT_PUBLIC_SERVER_URL=http://localhost:3010
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# RustFS S3 Storage
STORAGE_PROVIDER=rustfs
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=your-access-key
RUSTFS_SECRET_KEY=your-secret-key
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=dealio-uploads
RUSTFS_FORCE_PATH_STYLE=true
RUSTFS_PUBLIC_URL=http://localhost:9000
