# Node Environment & Server Configuration
NODE_ENV=development
PORT=3002

# Database Connection (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scryme

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_minimum_32_characters_long
BETTER_AUTH_URL=http://localhost:3000

# Client & Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_PROJECTS_URL=http://localhost:3002
NEXT_PUBLIC_AUTH_URL=http://localhost:4444
NEXT_PUBLIC_COOKIE_DOMAIN=localhost

# Realtime & Websocket Configuration
# Provider can be 'ably' or 'socketio'
NEXT_PUBLIC_REALTIME_PROVIDER=socketio
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002
NEXT_PUBLIC_WS_URL=http://localhost:3002

# OpenPanel Analytics Configuration (Optional)
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=your-openpanel-client-id
NEXT_PUBLIC_OPENPANEL_HOST=https://api.openpanel.dev
