# ---------------------------------------------------------
# Stage 1: Base Image & Package Manager Setup
# ---------------------------------------------------------
FROM node:22-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm safely via npm (aligned with version 10.34.1)
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN npm install -g pnpm@10.34.1

# ---------------------------------------------------------
# Stage 2: Pruner (Turborepo)
# ---------------------------------------------------------
FROM base AS pruner
WORKDIR /app

# Install turbo globally to ensure reliable execution
RUN pnpm add -g turbo

# Copy full source first so turbo can analyze the monorepo structure
COPY . .

# Remove potentially conflicting build artifacts from the host
RUN rm -rf .turbo && rm -rf node_modules

# Run prune on site-next
RUN turbo prune site-next --docker

# ---------------------------------------------------------
# Stage 3: Installer & Deployer
# ---------------------------------------------------------
FROM base AS deployer
WORKDIR /app

# Set non-interactive CI flags and disable telemetry
ENV CI=true \
    SANITY_TELEMETRY=false \
    DO_NOT_TRACK=1 \
    NODE_OPTIONS="--max-old-space-size=4096"

# Copy the pruned lockfile and package.json files
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml

# Install dependencies including sanity CLI and schema dependencies
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile --dangerously-allow-all-builds --ignore-scripts

# Copy full source code
COPY --from=pruner /app/out/full/ .

# Generate Prisma Client / SDK TypeScript types
RUN pnpm turbo run generate && pnpm --filter @repo/env build

WORKDIR /app/apps/site-next

# Disable Sanity CLI telemetry persistently in user config
RUN npx --no-install sanity telemetry disable || true

ENTRYPOINT ["sh", "-c"]
CMD ["SANITY_AUTH_TOKEN=\"${SANITY_AUTH_TOKEN:-${SANITY_API_TOKEN:-$SANITY_TOKEN}}\" pnpm run schema:deploy"]
