{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Scryme Bakery",
  "version": "10.1.22",
  "identifier": "com.scryme.bakery",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scryme Bakery",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.scryme.tech/api/v3/production/update/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5MDI4Q0FCQjI4MzA4RkYKUlNXdmpzeUx3MlhKY1ZmdndyVWk4Z1U2YVRXVTNzTXhXNlpyTmd4cDR6clM4SXZXWGlmVTJmSE0K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
